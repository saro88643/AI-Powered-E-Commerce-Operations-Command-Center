FROM node:20-alpine

WORKDIR /app

# Copy root and shared packages
COPY package*.json ./
COPY packages ./packages
COPY apps/backend ./apps/backend
COPY data ./data

# Install dependencies and build shared packages
RUN npm install
RUN npm --prefix packages/shared-types run build || true
RUN npm --prefix apps/backend install

WORKDIR /app/apps/backend

EXPOSE 3000

CMD ["node", "src/server.js"]
