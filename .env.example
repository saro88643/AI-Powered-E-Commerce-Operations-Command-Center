# ShopSphere Operations Command Center — Environment Variables

NODE_ENV=development
PORT=3000
AI_SERVICE_PORT=5000
AI_SERVICE_URL=http://localhost:5000

# External Simulated Services Ports
INVENTORY_API_PORT=4001
DELIVERY_API_PORT=4002
PAYMENT_API_PORT=4003
CRM_API_PORT=4004

INVENTORY_API_URL=http://localhost:4001
DELIVERY_API_URL=http://localhost:4002
PAYMENT_API_URL=http://localhost:4003
CRM_API_URL=http://localhost:4004

# Database Connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopsphere
MONGODB_URI=mongodb://localhost:27017/shopsphere
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# Security & JWT
JWT_SECRET=shopsphere_super_secret_jwt_key_2026_fde_production
JWT_EXPIRES_IN=7d

# AI Agent & LLM Configuration
# Set AI_PROVIDER to 'demo' for out-of-the-box deterministic tool-calling without an external key
# Set to 'openai' or 'compatible' when using a live LLM
AI_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Frontend URL
VITE_API_URL=http://localhost:3000
VITE_AI_URL=http://localhost:5000
